<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/ime_recovery_heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ime_recovery_title"
            android:textAppearance="?attr/textAppearanceHeadlineSmall"
            android:accessibilityHeading="true"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/ime_recovery_explanation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ime_recovery_explanation"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/ime_recovery_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="120dp"
            android:padding="16dp"
            android:background="@drawable/bg_ime_key"
            android:saveEnabled="false"
            android:textIsSelectable="true"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/ime_recovery_copy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ime_recovery_copy" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/ime_recovery_keep"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ime_recovery_keep" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/ime_recovery_delete"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ime_recovery_delete" />
    </LinearLayout>
</ScrollView>
