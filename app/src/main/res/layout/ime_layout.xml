<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="?attr/colorSurface"
    android:padding="12dp">

    <!-- Status row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/ime_status_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Tap to speak"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:paddingStart="4dp"/>

        <ProgressBar
            android:id="@+id/ime_progress"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:visibility="gone"/>
    </LinearLayout>

    <!-- Record area: pulsing mic-level glow behind a circular record button -->
    <FrameLayout
        android:id="@+id/ime_record_container"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:clickable="true"
        android:focusable="true">

        <dev.notune.transcribe.MicLevelView
            android:id="@+id/ime_mic_level"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_gravity="center"/>

        <View
            android:id="@+id/ime_record_circle"
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_ime_record"/>

        <ImageView
            android:id="@+id/ime_mic_icon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_mic"
            android:layout_gravity="center"
            android:contentDescription="@string/section_ime"/>

        <TextView
            android:id="@+id/ime_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tap to Record"
            android:layout_gravity="center_horizontal|bottom"
            android:layout_marginBottom="12dp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textAppearance="?attr/textAppearanceBodySmall"/>
    </FrameLayout>

    <!-- Recording replaces the microphone target with a reachable 2x2 action
         grid: pause/cancel in the left column and insert/insert+switch in the right. -->
    <LinearLayout
        android:id="@+id/ime_recording_actions"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:paddingBottom="4dp">

            <ImageButton
                android:id="@+id/ime_pause_resume"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:minHeight="72dp"
                android:minWidth="72dp"
                android:background="@drawable/bg_ime_key"
                android:contentDescription="@string/ime_pause_recording"
                android:padding="22dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_pause"
                android:tint="?attr/colorOnSurfaceVariant" />

            <ImageButton
                android:id="@+id/ime_transcribe_keep"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:minHeight="72dp"
                android:minWidth="72dp"
                android:background="@drawable/bg_ime_key"
                android:contentDescription="@string/ime_transcribe_keep"
                android:padding="22dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_paste"
                android:tint="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:paddingTop="4dp">

            <ImageButton
                android:id="@+id/ime_cancel_recording"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:minHeight="72dp"
                android:minWidth="72dp"
                android:background="@drawable/bg_ime_key"
                android:contentDescription="@string/ime_cancel_recording"
                android:padding="22dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_close"
                android:tint="?attr/colorOnSurfaceVariant" />

            <ImageButton
                android:id="@+id/ime_transcribe_switch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:minHeight="72dp"
                android:minWidth="72dp"
                android:background="@drawable/bg_ime_key"
                android:contentDescription="@string/ime_transcribe_switch"
                android:padding="22dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_keyboard_switch"
                android:tint="?attr/colorOnSurfaceVariant" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom key row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:paddingTop="8dp">

        <ImageView
            android:id="@+id/ime_space"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:src="@drawable/ic_space"
            android:scaleType="centerInside"
            android:background="@drawable/bg_ime_key"
            android:tint="?attr/colorOnSurfaceVariant"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="8dp"
            android:contentDescription="Space"/>

        <ImageView
            android:id="@+id/ime_enter"
            android:layout_width="64dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_enter"
            android:scaleType="centerInside"
            android:background="@drawable/bg_ime_key"
            android:tint="?attr/colorOnSurfaceVariant"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="8dp"
            android:contentDescription="Enter"/>

        <ImageView
            android:id="@+id/ime_backspace"
            android:layout_width="64dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_backspace"
            android:scaleType="centerInside"
            android:background="@drawable/bg_ime_key"
            android:tint="?attr/colorOnSurfaceVariant"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="8dp"
            android:contentDescription="Backspace"/>

        <ImageView
            android:id="@+id/ime_switch_keyboard"
            android:layout_width="64dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_keyboard_switch"
            android:scaleType="centerInside"
            android:background="@drawable/bg_ime_key"
            android:tint="?attr/colorOnSurfaceVariant"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/ime_switch_keyboard"/>
    </LinearLayout>

</LinearLayout>
