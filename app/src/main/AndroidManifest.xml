<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:glEsVersion="0x00030002" android:required="true" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Select and clear the optional communication microphone route. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Install-time capability only. The app opens no connection until the user
         confirms an exact model download in ModelsActivity. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Package visibility (Android 11+): lets resolveActivity()/queryIntentActivities()
         for the speech intent see other handlers, so MainActivity can tell whether this
         app is the resolved handler or a chooser would appear. -->
    <queries>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
        <intent><action android:name="android.view.InputMethod" /></intent>
    </queries>

    <application
        android:name=".App"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/AppTheme"
        android:hasCode="true">

        <!-- Main Activity -->
        <activity
            android:name=".MainActivity"
            android:label="@string/app_name"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Speech model management -->
        <activity
            android:name=".ModelsActivity"
            android:label="@string/models_title"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:exported="false" />

        <activity
            android:name=".CustomTermsActivity"
            android:label="@string/custom_terms_title"
            android:exported="false" />

        <!-- Live Subtitles Activity (for permissions) -->
        <activity
            android:name=".LiveSubtitleActivity"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:exported="false" />
            
        <!-- RecognizerIntent entry point (for SwiftKey chooser) -->
        <activity
            android:name=".RecognizeActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:theme="@style/AppTheme.VoicePanel">

            <intent-filter>
                <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>


        <!-- Transcribe shared audio file -->
        <activity
            android:name=".TranscribeFileActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:exported="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:theme="@style/AppTheme">

            <!-- Handle "Share" from other apps. Messengers share voice notes as audio/*
                 (AAC, M4A, Ogg/Opus, MP3), as video/mp4 or 3GPP for video and some voice
                 notes, as application/ogg, or as generic binary data. A generic share is
                 accepted only with an audio file name, and every file must still contain a
                 decodable audio track. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="application/ogg" />
                <data android:mimeType="video/mp4" />
                <data android:mimeType="video/3gpp" />
                <data android:mimeType="video/webm" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>

            <!-- Handle "Open with" for audio files -->
            <intent-filter tools:ignore="AppLinkUrlError">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <!-- MIME-only VIEW is intentional for Android's Open with flow. -->
                <data android:mimeType="audio/*" />
                <data android:mimeType="application/ogg" />
            </intent-filter>
        </activity>

        <!-- Public activity-result contract: transcribe the granted content Uri in the
             intent data and return RecognizerIntent.EXTRA_RESULTS. Standard launch mode so
             the result always reaches the requesting activity. -->
        <activity
            android:name=".TranscribeAudioActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@style/AppTheme">
            <intent-filter tools:ignore="AppLinkUrlError">
                <action android:name="app.offlinespeechtotext.action.TRANSCRIBE_AUDIO" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" android:mimeType="*/*" />
            </intent-filter>
            <!-- A provider may report no type for its Uri. -->
            <intent-filter>
                <action android:name="app.offlinespeechtotext.action.TRANSCRIBE_AUDIO" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
            </intent-filter>
        </activity>

        <!-- Long-form recording: one non-exported foreground owner. -->
        <activity
            android:name=".ForegroundRecordingActivity"
            android:exported="false" />
        <activity
            android:name=".ForegroundResultActivity"
            android:exported="false" />
        <activity
            android:name=".ImeTranscriptRecoveryActivity"
            android:excludeFromRecents="true"
            android:exported="false" />
        <receiver
            android:name=".ForegroundRecordingActionReceiver"
            android:exported="false" />
        <service
            android:name=".ForegroundRecordingService"
            android:foregroundServiceType="microphone|shortService"
            android:stopWithTask="false"
            android:exported="false" />

        <!-- Live Subtitles Service -->
        <service
            android:name=".LiveSubtitleService"
            android:foregroundServiceType="mediaProjection"
            android:exported="false" />

        <!-- Speech-to-text provider for other keyboards (SwiftKey, Gboard, …).
             Declared in the manifest so it is always discoverable via
             SpeechRecognizer, even when the app process isn't running. -->
        <service
            android:name=".VoiceRecognitionService"
            android:label="@string/recognition_service_label"
            android:permission="android.permission.BIND_RECOGNITION_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.speech.RecognitionService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.speech"
                android:resource="@xml/recognition_service" />
        </service>

        <!-- IME Service -->
        <service
            android:name=".RustInputMethodService"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_INPUT_METHOD"
            android:exported="true">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_provider_paths" />
        </provider>

    </application>
</manifest>
